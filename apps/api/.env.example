# Database — SQLite by default so the project runs with no external services.
# Point this at PostgreSQL for a production deployment and switch the Prisma
# datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Signing key for API access tokens. Generate a fresh value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-every-environment"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Seed password for the demo accounts created by `npm run db:seed`.
SEED_PASSWORD="Password123!"
